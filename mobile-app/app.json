{
  "expo": {
    "name": "Photo & PDF Tools Pro",
    "slug": "photo-pdf-tools-pro-mobile",
    "version": "26.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "photopdftoolspro",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090B10"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.phototools.pdfpro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#090B10"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
